<?xml version="1.0" encoding="utf-8"?>
<!-- O aplicativo só guarda a linha vermelha escolhida pelo usuário; não há banco nem
     arquivos de leitura. Nada vai para a nuvem nem é transferido entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
